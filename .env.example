# Copy to .env and adjust.

# SQLite database file (default: local.db)
DB_FILE_NAME=local.db

# Secret used to sign the session cookie. At least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# Demo mode: shows the guardian switcher in the top bar (switch without a password,
# Shift+R = nova <-> ember). "true" = on, "false" = off; left out = on in dev, off in production builds.
# NEVER set it to true in production.
DEMO_MODE=true
